{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ai-zippy/page-hero",
  "version": "1.0.0",
  "title": "Achiever Page Hero",
  "category": "achiever-shared",
  "icon": "cover-image",
  "description": "Pastel page hero banner for Achiever's Art inner pages.",
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Achiever's Art"
    },
    "heading": {
      "type": "string",
      "default": "Page Title"
    },
    "subtitle": {
      "type": "string",
      "default": "Discover your creative journey through art."
    },
    "ctaText": {
      "type": "string",
      "default": ""
    },
    "ctaUrl": {
      "type": "string",
      "default": "#"
    },
    "variant": {
      "type": "string",
      "default": "pink"
    }
  },
  "textdomain": "ai-zippy",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "render": "file:./render.php"
}
