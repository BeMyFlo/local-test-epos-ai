{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ai-zippy/home-best-sellers",
	"version": "2.0.0",
	"title": "Home Best Sellers",
	"category": "achiever-home",
	"icon": "star-filled",
