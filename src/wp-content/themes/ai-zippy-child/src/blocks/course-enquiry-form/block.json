{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ai-zippy/course-enquiry-form",
  "version": "2.0.0",
  "title": "Course Enquiry Form",
  "category": "achiever-shared",
  "icon": "email",
  "description": "Editable course enquiry heading, fields and submit message.",
  "supports": { "html": false, "anchor": true, "align": ["wide", "full"] },
  "attributes": {
    "heading": { "type": "string", "default": "ASK US QUESTIONS" },
    "subheading": { "type": "string", "default": "Book an appointment" },
    "submitText": { "type": "string", "default": "SEND ENQUIRY" },
    "successMessage": { "type": "string", "default": "Thanks! We'll get back to you shortly." },
    "mascotImage": { "type": "string", "default": "/wp-content/uploads/2026/07/Sensory-Playhaus_COLOR.png" },
    "mascotImageAlt": { "type": "string", "default": "Mascot Rocket" },
    "backgroundColor": { "type": "string", "default": "#fce4ee" },
    "backgroundImage": { "type": "string", "default": "" },
    "decorPencilsImage": { "type": "string", "default": "" },
    "decorPencilsAlt": { "type": "string", "default": "" },
    "decorPencilsZIndex": { "type": "number", "default": 5 },
    "decorPencilsDesktopX": { "type": "number", "default": 87 },
    "decorPencilsDesktopY": { "type": "number", "default": 88 },
    "decorPencilsDesktopSize": { "type": "number", "default": 140 },
    "decorPencilsMobileX": { "type": "number", "default": 78 },
    "decorPencilsMobileY": { "type": "number", "default": 95 },
    "decorPencilsMobileSize": { "type": "number", "default": 90 },
    "labels": {
      "type": "object",
      "default": {
        "name": "Name",
        "phone": "Phone Number",
        "email": "Email",
        "childAge": "Child's Age",
        "preferredContact": "Preferred Mode of Contact",
        "studio": "Our Studio",
        "programType": "Programme Type",
        "message": "Message"
      }
    },
    "preferredContactOption": { "type": "string", "default": "WhatsApp" },
    "studioOptions": {
      "type": "array",
      "default": ["Tampines Studio (Our Tampines Hub)", "Pasir Ris Studio (Downtown East)", "Bedok Studio (Heartbeat @ Bedok)"]
    },
    "programmeOptions": {
      "type": "array",
      "default": ["Regular Art Class", "Art Workshop", "Art Camp", "Art Short Course", "Beyond the Canvas", "Parties / Events"]
    },
    "selectedProgramme": { "type": "string", "default": "" },
    "placeholders": {
      "type": "object",
      "default": {
        "name": "Name",
        "phone": "Phone Number",
        "email": "Email",
        "childAge": "Children Age",
        "studio": "Our Studio",
        "programType": "Programme Type",
        "message": "Messages"
      }
    }
  },
  "textdomain": "ai-zippy",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
