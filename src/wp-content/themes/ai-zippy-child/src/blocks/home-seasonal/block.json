{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ai-zippy/home-seasonal",
	"version": "1.0.0",
	"title": "Home Seasonal Special",
	"category": "achiever-home",
	"description": "Seasonal special product grid with 4 product cards.",
	"supports": {
		"html": false
	},
	"textdomain": "ai-zippy",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.scss",
	"style": "file:./style.scss",
	"render": "file:./render.php",
	"attributes": {
		"sectionTitle": {
			"type": "string",
			"default": "seasonal special"
