					"name": "Name of Product",
					"category": "Category",
					"ageTime": "Age + Time Workshop",
					"image": "/wp-content/themes/ai-zippy-child/assets/images/achiever-home-mockup-1.png",
					"ctaUrl": "#"
				},
				{
					"name": "Name of Product",
					"category": "Category",
					"ageTime": "Age + Time Workshop",
					"image": "/wp-content/themes/ai-zippy-child/assets/images/achiever-home-mockup-1.png",
					"ctaUrl": "#"
				},
				{
					"name": "Name of Product",
					"category": "Category",
					"ageTime": "Age + Time Workshop",
					"image": "/wp-content/themes/ai-zippy-child/assets/images/achiever-home-mockup-1.png",
					"ctaUrl": "#"
				},
				{
					"name": "Name of Product",
					"category": "Category",
					"ageTime": "Age + Time Workshop",
					"image": "/wp-content/themes/ai-zippy-child/assets/images/achiever-home-mockup-1.png",
					"ctaUrl": "#"
				}
			]
		},
		"ctaText": {
			"type": "string",
			"default": "VIEW MORE WORKSHOP"
		},
		"ctaUrl": {
			"type": "string",
			"default": "/shop/"
