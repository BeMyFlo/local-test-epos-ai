{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ai-zippy/offering-listing",
  "version": "1.1.0",
  "title": "Offering Listing",
  "category": "achiever-shared",
  "icon": "screenoptions",
  "description": "Editable grid or carousel of classes, workshops, camps, or courses with decor cartoon icons.",
  "supports": { "html": false, "align": ["wide", "full"] },
  "attributes": {
    "heading": { "type": "string", "default": "" },
    "subheading": { "type": "string", "default": "" },
    "layout": { "type": "string", "default": "grid" },
    "items": { "type": "array", "default": [] },
    "decorLeftImage": { "type": "string", "default": "/wp-content/uploads/2026/07/Sensory-Playhaus_STICKER.png" },
    "decorLeftAlt": { "type": "string", "default": "Cartoon mascot left" },
    "decorLeftDesktopX": { "type": "number", "default": 5 },
    "decorLeftDesktopY": { "type": "number", "default": 10 },
    "decorLeftDesktopSize": { "type": "number", "default": 140 },
    "decorLeftMobileX": { "type": "number", "default": 5 },
    "decorLeftMobileY": { "type": "number", "default": 10 },
    "decorLeftMobileSize": { "type": "number", "default": 90 },
    "decorLeftZIndex": { "type": "number", "default": 5 },
    "decorRightImage": { "type": "string", "default": "/wp-content/uploads/2026/07/Sensory-Playhaus_COLOR.png" },
    "decorRightAlt": { "type": "string", "default": "Cartoon mascot right" },
    "decorRightDesktopX": { "type": "number", "default": 90 },
    "decorRightDesktopY": { "type": "number", "default": 85 },
    "decorRightDesktopSize": { "type": "number", "default": 160 },
    "decorRightMobileX": { "type": "number", "default": 85 },
    "decorRightMobileY": { "type": "number", "default": 85 },
    "decorRightMobileSize": { "type": "number", "default": 100 },
    "decorRightZIndex": { "type": "number", "default": 5 }
  },
  "textdomain": "ai-zippy",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}
