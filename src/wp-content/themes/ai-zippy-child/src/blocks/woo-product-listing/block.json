{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ai-zippy/woo-product-listing",
  "version": "1.0.0",
  "title": "Woo Product Listing",
  "category": "achiever-shared",
  "icon": "cart",
  "description": "WooCommerce-backed product category filters and product grid.",
  "supports": { "html": false, "align": ["wide", "full"] },
  "attributes": {
    "heading": { "type": "string", "default": "" },
    "categoriesTitle": { "type": "string", "default": "Categories" },
    "allCategoriesText": { "type": "string", "default": "All" },
    "emptyMessage": { "type": "string", "default": "Products will appear here when WooCommerce products are available." },
    "productsPerPage": { "type": "number", "default": 12 }
  },
  "textdomain": "ai-zippy",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
