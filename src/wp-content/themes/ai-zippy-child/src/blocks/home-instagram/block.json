{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ai-zippy/home-instagram",
	"version": "2.0.0",
	"title": "Home Instagram",
	"category": "achiever-home",
	"icon": "instagram",
	"description": "Follow us on Instagram image grid section.",
	"keywords": [
		"instagram",
		"social",
		"gallery",
		"feed"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "FOLLOW US ON INSTAGRAM"
		},
		"decorLeftImage": { "type": "string", "default": "" },
		"decorLeftAlt": { "type": "string", "default": "Cartoon mascot left decoration" },
		"decorRightImage": { "type": "string", "default": "" },
		"decorRightAlt": { "type": "string", "default": "Cartoon mascot right decoration" },
		"images": {
			"type": "array",
			"default": [
				{
					"url": "", "alt": "Instagram photo 1", "link": ""
				},
				{
					"url": "", "alt": "Instagram photo 2", "link": ""
				},
				{
					"url": "", "alt": "Instagram photo 3", "link": ""
				},
				{
					"url": "", "alt": "Instagram photo 4", "link": ""
				}
			]
		}
	},
	"textdomain": "ai-zippy",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
