    "decorRightAlt": { "type": "string", "default": "Pencil jar top-right decoration" },
    "types": {
      "type": "array",
      "default": [
        { "label": "Regular Art Classes", "subtitle": "(Weekly)", "image": "", "alt": "Regular Art Classes photo", "url": "" },
        { "label": "Art Camps", "subtitle": "(4/6/8 Lessons)", "image": "", "alt": "Art Camps photo", "url": "" },
        { "label": "Art Workshop", "subtitle": "(Single Session)", "image": "", "alt": "Art Workshop photo", "url": "" },
        { "label": "Short Courses", "subtitle": "(Weekly)", "image": "", "alt": "Short Courses photo", "url": "" },
        { "label": "Express Art Classes", "subtitle": "(Single Session)", "image": "", "alt": "Express Art Classes photo", "url": "" }
      ]
    }
  }
}
