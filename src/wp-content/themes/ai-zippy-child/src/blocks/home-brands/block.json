{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ai-zippy/home-brands",
  "version": "2.0.0",
  "title": "Home Brands",
  "category": "achiever-home",
  "description": "Beyond The Canvas brands showcase with 6 brand items.",
  "supports": {
    "html": false
  },
  "textdomain": "ai-zippy",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "render": "file:./render.php",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "BEYOND\nTHE CANVAS"
    },
    "description": {
      "type": "string",
      "default": "Beyond The Canvas by The Artivity Collective brings together a unique family of creative brands and experiences designed to inspire self-expression, hands-on learning, and artistic exploration for all ages."
    },
    "decorImage": { "type": "string", "default": "" },
    "decorAlt": { "type": "string", "default": "Cat decoration" },
    "decorDesktopX": { "type": "number", "default": 8 },
    "decorDesktopY": { "type": "number", "default": 15 },
    "decorDesktopSize": { "type": "number", "default": 60 },
    "decorMobileX": { "type": "number", "default": 12 },
    "decorMobileY": { "type": "number", "default": 12 },
    "decorMobileSize": { "type": "number", "default": 60 },
    "decorZIndex": { "type": "number", "default": 5 },
    "decorLeftImage": { "type": "string", "default": "" },
    "decorLeftAlt": { "type": "string", "default": "Cartoon mascot left decoration" },
    "decorLeftDesktopX": { "type": "number", "default": 8 },
    "decorLeftDesktopY": { "type": "number", "default": 85 },
    "decorLeftDesktopSize": { "type": "number", "default": 120 },
    "decorLeftMobileX": { "type": "number", "default": 12 },
    "decorLeftMobileY": { "type": "number", "default": 85 },
    "decorLeftMobileSize": { "type": "number", "default": 75 },
    "decorLeftZIndex": { "type": "number", "default": 5 },
    "decorRightImage": { "type": "string", "default": "" },
    "decorRightAlt": { "type": "string", "default": "Cartoon mascot right decoration" },
    "decorRightDesktopX": { "type": "number", "default": 92 },
    "decorRightDesktopY": { "type": "number", "default": 15 },
    "decorRightDesktopSize": { "type": "number", "default": 120 },
    "decorRightMobileX": { "type": "number", "default": 88 },
    "decorRightMobileY": { "type": "number", "default": 15 },
    "decorRightMobileSize": { "type": "number", "default": 75 },
    "decorRightZIndex": { "type": "number", "default": 5 },
    "brandIconSize": { "type": "number", "default": 120 },
    "brandsColumns": { "type": "number", "default": 3 },
    "brandsIntro": {
      "type": "string",
      "default": "Unique experiences by Achievers Arts"
    },
    "brands": {
      "type": "array",
      "default": [
        { "name": "Artivity", "icon": "", "alt": "Artivity logo", "caption": "Home of creative camps, crafts, and artistic merch.", "featured": true },
        { "name": "Art a Space", "icon": "", "alt": "Art a Space logo", "caption": "Express yourself through abstract art." },
        { "name": "Sensory Playhaus", "icon": "", "alt": "Sensory Playhaus logo", "caption": "Hands-on sensory play for little explorers." },
        { "name": "Yanails Atelier", "icon": "", "alt": "Yanails Atelier logo", "caption": "Design your own press-on nails." },
        { "name": "The Glam Bakes", "icon": "", "alt": "The Glam Bakes logo", "caption": "DIY polymer clay & shrinky dink accessories." },
        { "name": "Minipreneur Academy", "icon": "", "alt": "Minipreneur Academy logo", "caption": "Learn to create, sell, and thrive." },
        { "name": "Arts Curate", "icon": "", "alt": "Arts Curate logo", "caption": "Painting by local artists for sale." }
      ]
    },
    "galleryImages": {
      "type": "array",
      "default": [
        { "url": "", "alt": "Studio moment photo 1" },
        { "url": "", "alt": "Studio moment photo 2" },
        { "url": "", "alt": "Studio moment photo 3" },
        { "url": "", "alt": "Studio moment photo 4" },
        { "url": "", "alt": "Studio moment photo 5" }
      ]
    },
    "features": {
      "type": "array",
      "default": []
    },
    "ctaText": {
      "type": "string",
      "default": "READ MORE"
    },
    "ctaUrl": {
      "type": "string",
      "default": "https://www.artivitytime.com/"
