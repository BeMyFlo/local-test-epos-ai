{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ai-zippy/home-party",
	"version": "3.0.0",
	"title": "Home Party",
	"category": "achiever-home",
	"icon": "megaphone",
	"description": "Source-faithful party section with two event photos.",
	"keywords": [
		"party",
		"events",
		"birthday",
		"corporate"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"attributes": {
		"preHeading": {
			"type": "string",
			"default": "IT'S"
		},
		"heading": {
			"type": "string",
			"default": "PARTY TIME!"
		},
		"subtitle": {
			"type": "string",
			"default": "BIRTHDAYS \u00b7 GROUP BOOKINGS \u00b7 CORPORATE EVENTS \u00b7 TEAM BONDING"
		},
		"decorLeftImage": { "type": "string", "default": "" },
		"decorLeftAlt": { "type": "string", "default": "Party character decoration" },
		"decorLeftDesktopX": { "type": "number", "default": 10 },
		"decorLeftDesktopY": { "type": "number", "default": 15 },
		"decorLeftDesktopSize": { "type": "number", "default": 150 },
		"decorLeftMobileX": { "type": "number", "default": 12 },
		"decorLeftMobileY": { "type": "number", "default": 15 },
		"decorLeftMobileSize": { "type": "number", "default": 75 },
		"decorLeftZIndex": { "type": "number", "default": 5 },
		"decorRightImage": { "type": "string", "default": "" },
		"decorRightAlt": { "type": "string", "default": "Cake decoration" },
		"decorRightDesktopX": { "type": "number", "default": 90 },
		"decorRightDesktopY": { "type": "number", "default": 15 },
		"decorRightDesktopSize": { "type": "number", "default": 150 },
		"decorRightMobileX": { "type": "number", "default": 88 },
		"decorRightMobileY": { "type": "number", "default": 15 },
		"decorRightMobileSize": { "type": "number", "default": 75 },
		"decorRightZIndex": { "type": "number", "default": 5 },
		"images": {
			"type": "array",
			"default": [
				{
					"url": "",
					"alt": "Birthday party photo"
				},
				{
					"url": "",
					"alt": "Group event photo"
				}
			]
		},
		"ctaText": {
			"type": "string",
			"default": "ADVANCED BOOK NOW"
		},
		"ctaUrl": {
			"type": "string",
			"default": "#"
		}
	},
	"textdomain": "ai-zippy",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
