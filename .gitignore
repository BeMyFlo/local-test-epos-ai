# Dependencies
node_modules
package-lock.json
yarn.lock

# Build output
src/wp-content/themes/ai-zippy/assets/dist
src/wp-content/themes/ai-zippy/assets/dist-admin
src/wp-content/themes/ai-zippy/assets/blocks
src/wp-content/themes/ai-zippy-child/assets/dist
src/wp-content/themes/ai-zippy-child/assets/blocks

# Environment
.env

# WordPress default themes (not needed)
src/wp-content/themes/twentytwentyone
src/wp-content/themes/twentytwentytwo
src/wp-content/themes/twentytwentythree
src/wp-content/themes/twentytwentyfour
src/wp-content/themes/twentytwentyfive

# Ignore ALL plugins (install manually, via Composer, or WP admin)
# Only keep the WordPress silence file (index.php)
src/wp-content/plugins/*
!src/wp-content/plugins/index.php

# WordPress uploads and cache
src/wp-content/uploads
src/wp-content/upgrade
src/wp-content/cache

# OS files
.DS_Store
Thumbs.db

# Windows NTFS Alternate Data Streams (created when copying files from Windows to WSL)
*:Zone.Identifier
